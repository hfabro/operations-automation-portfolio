* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.png binary
*.pdf binary

# Generated BI projection has portable, checksum-stable text artifacts.
business-intelligence/* text eol=lf
tools/bi-public-manifest.json text eol=lf

# Authored business-time fixture projection has stable portable text bytes.
tools/bi-prototype/fixtures/*.json text eol=lf
